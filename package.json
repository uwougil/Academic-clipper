{
  "name": "academic-clipper",
  "version": "0.2.0",
  "private": true,
  "description": "Nature-first academic web clipper using Obsidian Web Clipper's Defuddle converter.",
  "type": "module",
  "bin": {
    "academic-clipper-bridge": "src/bridge.mjs"
  },
  "scripts": {
    "dev": "node --watch src/bridge.mjs",
    "start": "node src/bridge.mjs",
    "build": "node src/build.mjs",
    "test": "node --test",
    "clip:live": "node src/cli.mjs --url https://www.nature.com/articles/s41586-026-10401-1 --output ./papers --debug --download-figures"
  },
  "dependencies": {
    "defuddle": "^0.19.2",
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
